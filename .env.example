# ==============================================================================
# HireSphere AI - Backend Environment Configuration (.env)
# ==============================================================================
# Centralized backend configuration for Database, AI, Server Ports, and Security.

# ------------------------------------------------------------------------------
# 1. SERVER & PORT SETTINGS
# ------------------------------------------------------------------------------
SERVER_PORT=8085
APP_NAME=hiresphere-backend

# ------------------------------------------------------------------------------
# 2. EMBEDDED PERSISTENT DATABASE (DBMS)
# ------------------------------------------------------------------------------
# Local persistent file storage under ./data/
DB_URL=jdbc:h2:file:./data/hiresphere_realtime_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# H2 Database Interactive Web Console
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# JSON Snapshot Database Path
DATA_FILE_PATH=./data/hiresphere_realtime_db.json

# ------------------------------------------------------------------------------
# 3. AUTONOMOUS AGENTIC AI (GEMINI 1.5 FLASH / FREE TIER)
# ------------------------------------------------------------------------------
# Optional: Add your Google AI Studio Gemini API Key here.
# If empty, HireSphere automatically uses its intelligent built-in agent engine (0-cost fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent

# ------------------------------------------------------------------------------
# 4. REAL-TIME EVENT STREAMING (SSE)
# ------------------------------------------------------------------------------
REALTIME_STREAM_PATH=/api/realtime/stream

# ------------------------------------------------------------------------------
# 5. CORS & CLIENT SECURITY (Production & Local)
# ------------------------------------------------------------------------------
# Deployed Render Backend: https://hiresphereai.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,https://hire-sphere-ai-front-end.vercel.app,https://*.vercel.app
